{
  "name": "playwright-cucumber-bdd-project",
  "version": "1.0.0",
  "description": "Proyecto de automatización web con Playwright, TypeScript y Cucumber BDD",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:parallel": "cucumber-js --parallel 4",
    "test:debug": "cucumber-js --tags @debug",
    "playwright:install": "npx playwright install",
    "clean:reports": "rimraf reports screenshots allure-results allure-report",
    "clean:allure": "rimraf allure-results allure-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "typescript",
    "automation",
    "testing"
  ],
  "author": "QA Automation Engineer",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.40.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/pretty-formatter": "^4.0.1",
    "@types/node": "^20.10.4",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.2",
    "allure-js-commons": "^3.10.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
